# MiniMax API Key - used for AI-powered article analysis
MINIMAX_API_KEY=your_minimax_api_key_here

# Brave Search API Key - used by /verify for web-based corroboration.
# Optional: when omitted, the LLM steps still run but without web evidence.
# Get a free key at https://api-dashboard.search.brave.com/
BRAVE_SEARCH_API_KEY=

# Google Fact Check Tools API Key - used by the legacy /analyze fact-check
# step. Optional. https://developers.google.com/fact-check/tools/api
GOOGLE_API_KEY=
